# Every image this stack pulls is fetched by DIGEST, with the tag kept beside it
# for readability. Docker ignores the tag in `repo:tag@sha256:...`, so the two
# must be moved together: scripts/refresh_digests.py does that, and
# scripts/set_release.py does it for the emulator on release.
#
# `postgres` mattered most: it was `postgres:${POSTGRES_VERSION:-16}`, a rolling
# MAJOR with a default, so any Postgres published upstream became the database
# this stack was tested against without a commit anywhere.
# The pinned stack. Never latest.
#
# THE SAME PINS THE JOBS CELL RUNS, deliberately. Both cells drive the same
# engine; if this one moved independently, a difference in their numbers could
# be the orchestrator or could be the emulator, and nobody could say which. The
# comparison is only worth making when one variable moves at a time.
DATABRICKS_EMULATOR_VERSION=0.2.9
DATABRICKS_EMULATOR_DIGEST=sha256:c2ab6d0fecc2e9b954f9141661408fe2161eb19591ac9429886228667b47ebd2
# SAIL_ENGINE and SPARK_CLIENT are tagged for the DEPENDENCY they carry --
# pysail and pyspark-client -- because that is what a consumer pins them for.
# They used to be pinned on fabric-emulator's release number, which reads tidier
# and tells you nothing: `emulator-sail:0.33.0` does not say which Sail is
# inside, and both tags are published over the same bytes. Three fields, three
# jobs: _VERSION is the tag (what Sail you get), _DIGEST is the identity (which
# build exactly), _RELEASE is the fabric-emulator release that packaged it, read
# from the image's own org.opencontainers.image.version label.
#
# _RELEASE is DERIVED, never typed: refresh_digests.py writes it and CI re-reads
# the label off the pinned digest and fails if this file disagrees. It exists
# because first-party launcher and agent code moves every fabric release under
# an UNCHANGED tag -- invisible unless you diff digests by eye.
SAIL_ENGINE_VERSION=0.7.0
SAIL_ENGINE_DIGEST=sha256:f2bc4a48b51e40ec32d82964397887554d11b44dab1ff624eff581872083b693
SAIL_ENGINE_RELEASE=0.34.0
SPARK_CLIENT_VERSION=4.2.0
SPARK_CLIENT_DIGEST=sha256:7afe03dcbbf959f0b8dea0685a2435145857beddafa6feeda4c7c9f331ca49c7
SPARK_CLIENT_RELEASE=0.34.0
UC_VERSION=v0.5.0
UC_DIGEST=sha256:c664f371629059f17d778c0da6d1623a4496bd7e6a72f3e17d972c13832315de

# Airflow itself, and the database behind it. The worker image is built FROM
# this tag, so it is what the product's dependencies are resolved against.
AIRFLOW_VERSION=3.3.1
POSTGRES_VERSION=16
POSTGRES_DIGEST=sha256:f1c3376c26f2609ab9f29f71f824103fe2fcd8ee0346485cb6122a4f93df6f94
