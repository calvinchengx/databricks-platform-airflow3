# The pinned stack. Never latest.
#
# THE SAME PINS THE JOBS CELL RUNS, deliberately. Both cells drive the same
# engine; if this one moved independently, a difference in their numbers could
# be the orchestrator or could be the emulator, and nobody could say which. The
# comparison is only worth making when one variable moves at a time.
DATABRICKS_EMULATOR_VERSION=0.2.9
SAIL_VERSION=0.32.0
SPARK_AGENT_VERSION=0.32.0
UC_VERSION=v0.5.0

# Airflow itself, and the database behind it. The worker image is built FROM
# this tag, so it is what the product's dependencies are resolved against.
AIRFLOW_VERSION=3.3.1
POSTGRES_VERSION=16
